{
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 1000,
  "mode": "weak",
  "format": ["java", "javascript", "markup", "properties"],
  "pattern": "**/*.{java,js,xml,properties,html,jsp}",
  "reporters": ["console", "codecharta"],
  "reportersOptions": {
    "codecharta": {
      "projectRoot": ".",
      "projectName": "myproject clones",
      "output": "reports/jscpd/codecharta-clones.cc.json"
    }
  },
  "output": "reports/jscpd",
  "absolute": true,
  "noTips": true,
  "ignore": ["**/target/**", "**/node_modules/**", "**/*.min.js"]
}
